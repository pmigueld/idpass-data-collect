{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@/form-builder": ["./src/form-builder/index.ts"],
      "@/form-builder/*": ["./src/form-builder/*"],
      "@idpass/data-collect-core": ["../datacollect/src/interfaces/types.ts"]
    }
  }
}
