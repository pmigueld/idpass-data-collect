{
  "name": "@idpass/ui-components",
  "version": "1.0.0",
  "description": "Shared UI components for ID PASS DataCollect applications",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "shadcn:add": "shadcn-vue add"
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.469.0",
    "tailwind-merge": "^2.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^3.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.0.0",
    "formiojs": "^5.0.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.1",
    "prettier": "^3.5.3",
    "shadcn-vue": "^0.10.5",
    "tailwindcss": "^4.0.0-alpha.34",
    "typescript": "~5.8.0",
    "vite": "^6.2.4",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.8"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idpass/idpass-data-collect.git"
  },
  "keywords": [
    "ui-components",
    "shadcn-vue",
    "vue",
    "typescript"
  ],
  "author": "IDPass",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/idpass/idpass-data-collect/issues"
  },
  "homepage": "https://github.com/idpass/idpass-data-collect#readme"
}